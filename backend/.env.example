# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://clude_user:clude_password@localhost:5432/clude_db
DATABASE_SYNC_URL=postgresql://clude_user:clude_password@localhost:5432/clude_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI LLM Provider Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PRIMARY_LLM_PROVIDER=anthropic # or openai
EMBEDDING_MODEL=text-embedding-3-large
REASONING_MODEL=claude-3-5-sonnet-20241022

# GitHub OAuth App Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# Security & Tokens
SECRET_KEY=generate_a_secure_random_key_here_for_jwt_and_encryption
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
